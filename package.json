{
  "name": "boogle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One island, one beach ball, and everyone who has the page open.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
