{
  "name": "boogle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One island, one beach ball, and everyone who has the page open.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:net": "node dev/peer-test/run.mjs",
    "load": "node dev/peer-test/load.mjs",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run registry && npm run build",
    "test:unit": "node --test --test-timeout=5000 'test/**/*.test.mjs' 'test/**/*.test.ts'",
    "check:full": "npm run check && npm --prefix server test && npm run test:net",
    "check:gpu": "node dev/scenarios/run.mjs smoke",
    "look": "node dev/look/look.mjs",
    "registry": "node dev/registry/check.mjs",
    "atlas": "node dev/atlas/cli.mjs",
    "inflight": "node dev/inflight.mjs",
    "wip": "node dev/inflight.mjs wip",
    "perf": "node dev/look/perf.mjs",
    "hitches": "node dev/look/hitches.mjs",
    "island-map": "node dev/island/map.mjs",
    "concepts": "node dev/concepts/generate.mjs",
    "scenario": "node dev/scenarios/run.mjs",
    "scenarios": "node dev/scenarios/run.mjs",
    "ship": "bash scripts/ship.sh",
    "prepare": "git config core.hooksPath .githooks || true",
    "clip": "node dev/video/clip.mjs",
    "reel": "node dev/video/reel.mjs",
    "video:changes": "node dev/video/changes.mjs",
    "video:publish": "node dev/video/publish.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.19.3",
    "d3-hierarchy": "3.1.2",
    "d3-interpolate": "3.0.1",
    "d3-sankey": "0.12.3",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-transition": "3.0.1",
    "peerjs": "1.5.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "peer": "1.0.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "6.4.5",
    "vite-plugin-wasm": "^3.6.0"
  }
}
