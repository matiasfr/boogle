    "peerjs": "1.5.4",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "peer": "1.0.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "vite": "6.4.5"
  }
}
