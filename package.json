{
  "name": "boogle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One island, one beach ball, and everyone who has the page open.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "audio:measure": "node dev/audio/render.ts --broker",
    "audio:analyze": "node dev/audio/analyze.ts",
    "dev": "vite",
    "postinstall": "npm --prefix server ci --no-audit --no-fund",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node dev/lint/run.ts",
    "format": "prettier --write .",
    "test:net": "node dev/peer-test/ws-run.ts",
    "load": "WS_LOAD=1 node dev/peer-test/ws-run.ts",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "check": "node dev/check.ts",
    "test:unit": "node dev/test-unit.ts",
    "test:long": "node dev/test-unit.ts --long",
    "check:full": "node dev/check.ts --full",
    "check:gpu": "node dev/scenarios/run.ts smoke",
    "patch": "node dev/patch.ts",
    "map": "node dev/map.ts",
    "models": "node dev/models.ts",
    "economy": "node dev/economy/cli.ts",
    "loop": "node dev/loop/cli.ts",
    "unused": "node dev/scan/unused.ts",
    "look": "node dev/look/look.ts",
    "session": "node dev/look/session.ts",
    "playthrough": "node dev/look/playthrough.ts",
    "checkpoints": "node dev/look/checkpoints.ts",
    "checks-for": "node dev/checks-for.ts",
    "before-after": "node dev/look/before-after.ts",
    "sheet": "node dev/look/sheet.ts",
    "registry": "node dev/registry/check.ts",
    "decisions": "node dev/decisions/check.ts",
    "decisions:split": "node dev/decisions/split.ts",
    "atlas": "node dev/atlas/cli.ts",
    "daily": "node dev/daily/run.ts",
    "daily:install": "node dev/daily/install.ts",
    "daily:uninstall": "node dev/daily/install.ts --uninstall",
    "friends-report": "node dev/friends-report.ts",
    "inflight": "node dev/inflight.ts",
    "codex-status": "node dev/codex/status.ts",
    "wip": "node dev/inflight.ts wip",
    "perf": "node dev/look/perf.ts",
    "bench": "node dev/look/bench.ts",
    "hitches": "node dev/look/hitches.ts",
    "cold-start": "node dev/cold-start.ts",
    "cold-launch": "node dev/cold-launch.ts",
    "counts": "node dev/look/counts.ts",
    "island-map": "node dev/island/map.ts",
    "concepts": "node dev/concepts/generate.ts",
    "scenario": "node dev/scenarios/run.ts",
    "scenarios": "node dev/scenarios/run.ts",
    "ship": "bash scripts/ship.sh",
    "ship-branch": "bash dev/codex/ship-branch.sh",
    "ship-queue": "bash dev/ship-queue.sh",
    "review-stamp": "node dev/review-stamp.ts",
    "heartbeat": "bash dev/heartbeat.sh",
    "prepare": "git config core.hooksPath .githooks || true",
    "clip": "node dev/video/clip.ts",
    "reel": "node dev/video/reel.ts",
    "video:changes": "node dev/video/changes.ts",
    "video:publish": "node dev/video/publish.ts",
    "assets": "node dev/assets/build.ts",
    "prefabs": "node dev/prefab/build.ts",
    "prefab:new": "node dev/prefab/new.ts",
    "review-card": "node scripts/review-card.ts",
    "playtest": "node dev/playtest/cli.ts",
    "device": "node dev/device/cli.ts",
    "server": "node dev/server-admin.ts",
    "tune": "node dev/tune.ts",
    "sim": "node --import ./dev/sim/hooks.ts dev/sim/run.ts",
    "inspect": "node --import ./dev/sim/hooks.ts dev/sim/inspect.ts",
    "level-check": "node --import ./dev/sim/hooks.ts dev/level/check.ts",
    "transcript": "node dev/transcript.ts",
    "queue": "node dev/codex/queue.ts",
    "ship-watch": "node dev/codex/ship-watch.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.21.0",
    "@dimforge/rapier3d-simd": "0.21.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "d3-hierarchy": "3.1.3",
    "d3-interpolate": "3.0.2",
    "d3-sankey": "0.12.3",
    "d3-selection": "3.0.1",
    "d3-shape": "3.2.1",
    "d3-transition": "3.0.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/scope-manager": "8.72.1",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "esquery": "1.7.0",
    "globals": "17.14.0",
    "ignore": "7.0.14",
    "knip": "6.44.1",
    "meshoptimizer": "1.3.0",
    "oxc-parser": "0.157.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "source-map-js": "1.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-wasm": "3.6.0"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3"
  }
}
