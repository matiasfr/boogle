{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:full)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(npm run test:unit *)",
      "Bash(npm run test:net)",
      "Bash(npm run format:check)",
      "Bash(npm test *)",
      "Bash(npm --prefix server test)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx prettier --check *)",
      "Bash(npx eslint *)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)"
    ],
    "deny": ["Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push --no-verify *)"],
    "ask": ["Bash(npm run format)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-lint.mjs\"; [ ! -f \"$f\" ] || node \"$f\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
