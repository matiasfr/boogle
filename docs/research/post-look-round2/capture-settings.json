    "motion": "const {camera} = await import('/src/render/scene.ts');\nconst {onFrame} = await import('/src/loop.ts');\nconst Vector3 = camera.position.constructor;\nconst start=camera.position.clone();\nconst direction=new Vector3(0,0,-1).applyQuaternion(camera.quaternion);\nconst right=new Vector3(1,0,0).applyQuaternion(camera.quaternion);\nconst target=start.clone().addScaledVector(direction,12);\nconst p=start.clone(),t=target.clone();\nlet age=0;\nconst turn=new Vector3();\nconst axis=new Vector3(0,1,0);\nonFrame(({dt})=>{\n if(age>=8)return;\n age+=dt;\n const walk=Math.min(age,4)*1.5;\n const yaw=Math.max(0,Math.min(age-4,4))*Math.PI/36;\n p.copy(start).addScaledVector(right,walk);\n turn.copy(direction).applyAxisAngle(axis,yaw);\n t.copy(p).addScaledVector(turn,12);\n window.__debugCam.set(p.toArray(),t.toArray(),camera.fov);\n},{phase:'late',order:800});\nconsole.log('MOTION '+JSON.stringify({start:start.toArray(),direction:direction.toArray(),sequence:'0-4s lateral camera walk at 1.5m/s; 4-8s yaw at 5deg/s',realPlayerInput:false}));\nexport {};\n",
    "cost": "const {measureGraphics}=await import('/src/debug/dev/performance.ts');\nconst {lookSnapshot}=await import('/src/render/water/looks.ts');\nfor(let repeat=0;repeat<2;repeat++) {\n const result=await measureGraphics('postLooks',{seconds:3,warmSeconds:2,contention:'unknown'});\n console.log('COST '+JSON.stringify({repeat,look:lookSnapshot(),result}));\n}\nexport {};\n",
    "default-after": "const { renderer, scenePass, pipeline } = await import('/src/render/scene.ts');\nconst { observeGpu } = await import('/src/debug/prof-overlay.ts');\nconst { particleCounts } = await import('/src/render/particles.ts');\nconst observer = await observeGpu();\nconst backend = renderer.backend;\nconst compute = backend.compute;\nconst frames = new Map();\nbackend.compute = function (...args) {\n  const id = renderer.info.frame;\n  if (!frames.has(id)) frames.set(id, {names:[],passes:0});\n  frames.get(id).names.push(args[1].name || args[1].id);\n  frames.get(id).passes=renderer.info.compute.frameCalls;\n  return compute.apply(this, args);\n};\nawait new Promise(r => setTimeout(r, 4000));\nbackend.compute = compute;\nconst hist = {};\nfor (const row of [...frames.values()].slice(1,-1)) {\n  const key = JSON.stringify(row);\n  hist[key] = (hist[key] || 0) + 1;\n}\nconsole.log('PROOF ' + JSON.stringify({graph: {mrt: scenePass.getMRT(), outputs: scenePass.renderTarget.textures.map(t=>({name:t.name,type:t.type,format:t.format})), samples:scenePass.renderTarget.samples, output: pipeline.outputNode.constructor.name, transform:pipeline.outputColorTransform}, observed:observer.snapshot(), hist, particles: particleCounts(), modules:performance.getEntriesByType('resource').map(e=>e.name).filter(n=>/look-layers|look-coverage|water\\/looks/.test(n))}));\nobserver.stop();\nexport {};\n"
