{
  "id": "join",
  "title": "You join a room",
  "kind": "lock",
  "order": 60,
  "steps": [
    {
      "go": [["you.netplay", "server"]],
      "text": "Your tab opens one WebSocket to the server. The server checks the room, your player id and the player cap.",
      "code": "createWsRoom({ roomId, server, pid, key })",
      "cite": [
        {
          "file": "src/net/ws-room.ts",
          "symbol": "createWsRoom"
        }
      ]
    },
    {
      "go": [["server", "you.netplay"]],
      "text": "The server welcomes you and lists who is in the room. From here on it relays presence and messages between tabs.",
      "code": "{ t: 'welcome' } · { t: 'list' }",
      "cite": [
        {
          "message": "welcome"
        },
        {
          "file": "server/src/host/hosted-room.ts",
          "symbol": "createHostedRoom"
        }
      ]
    },
    {
      "go": [["server", "you.world"]],
      "text": "The server runs the shared world itself and sends you a snapshot of it. You apply edits from that tick on.",
      "code": "{ t: 'w:snap' } chunks",
      "cite": [
        {
          "message": "w:snap"
        }
      ]
    },
    {
      "hl": ["server"],
      "text": "The server saves the world to its own disk every 2 s when it changed, so the island survives, and keeps ticking, when everyone leaves.",
      "code": "createWorldHost({ roomId, store, saveMs })",
      "cite": [
        {
          "file": "server/src/host/world-host.ts",
          "symbol": "createWorldHost"
        },
        {
          "file": "server/src/store.ts",
          "symbol": "createStore"
        }
      ]
    }
  ]
