#!/usr/bin/env bash
# Installed automatically by `npm install` (package.json "prepare" sets core.hooksPath=.githooks).
# Plain `git push` to main runs the fast checks and refuses if main moved on (use `npm run ship`).
# Skip once with `git push --no-verify`.
set -euo pipefail

[ "${SHIP:-}" = "1" ] && exit 0 # npm run ship already rebased and checked

pushing_main=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ] && pushing_main=1
done
[ "$pushing_main" = "1" ] || exit 0

git fetch -q origin main 2>/dev/null || true
if ! git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
  echo "pre-push: main has new commits from a friend. Run 'npm run ship' (rebases, checks, pushes)." >&2
  exit 1
fi

echo "pre-push: running npm run check (a few seconds)..."
if ! npm run --silent check; then
  echo "pre-push: checks failed; fix them, or 'git push --no-verify' if you really must." >&2
  exit 1
fi
