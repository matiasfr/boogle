{
  "name": "boogle-server",
  "version": "1.0.0",
  "private": true,
  "description": "Boogle's game server: it hosts every room and runs its world",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "main": "src/server.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node --test --test-timeout=120000 test/*.test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "pngjs": "7.0.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
